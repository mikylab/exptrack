# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/

# Test/coverage artifacts (pytest-cov ships in the [dev] extra)
.coverage
.coverage.*
htmlcov/

# exptrack — local only (db, snapshots, config may contain auth tokens)
.exptrack/experiments.db
.exptrack/experiments.db-wal
.exptrack/experiments.db-shm
.exptrack/notebook_history/
.exptrack/config.json
.exptrack/backups/
outputs/

# other
.DS_Store

# Node (dev-only dashboard ESLint tooling)
node_modules/

# Ignore stray Markdown (scratch notes, generated reports) but keep the real
# documentation. NOTE: git never ignores an already-tracked file, so the pages
# under docs/ survived this rule by accident — a NEW page was silently dropped,
# with `git add` reporting nothing. Hence the explicit directory allowlists.
*.md

!README.md
!CLAUDE.md
!CHANGELOG.md
!CONTRIBUTING.md
!MAINTENANCE.md
!docs/**/*.md
!examples/**/*.md
!exptrack/**/*.md

# exptrack — local only (db + snapshots); config.json is safe to commit
.exptrack/dashboard_token
.exptrack/dashboard.json
.exptrack/dashboard.log
.exptrack/trash/

# Superpowers planning notes (brainstorm specs + plans) — local only
docs/superpowers/

# Tool caches (each also writes its own `*` .gitignore; listed so a deleted
# inner file can't let them through)
.pytest_cache/
.ruff_cache/

# Superpowers working state (visual companion, subagent scratch) — local only
.superpowers/

# This repo's own tracking data from dogfooding the dashboard — never commit
/.exptrack/
